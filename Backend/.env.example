# Server Configuration
PORT=4000
CLIENT_URL="http://localhost:5173"

# Database & Auth
# Get your URI from MongoDB Atlas (e.g., mongodb+srv://<user>:<password>@cluster...)
MONGODB_URI=""
# A long random string for security
JWT_SECRET=""

# Cloudinary (Image Storage)
# Get these from your Cloudinary Dashboard
CLOUDINARY_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Admin Credentials
ADMIN_EMAIL="admin@prescripto.com"
ADMIN_PASSWORD=""

# Payments (Stripe)
# Get your 'sk_test_...' key from Stripe Developers Dashboard
STRIPE_SECRET_KEY=""
CURRENCY=usd

# Email (Nodemailer)
# For Gmail, use smtp.gmail.com. For others, check your provider's SMTP settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=""
# IMPORTANT: This must be a 16-character App Password, NOT your regular password.
SMTP_PASS=""

# Google Login (OAuth 2.0)
# Get this from Google Cloud Console -> Credentials
GOOGLE_CLIENT_ID=""